# Copy to .env and adjust.

# SQLite is used when DATABASE_URL is unset. For PostgreSQL (see docker-compose.yml):
# DATABASE_URL=postgresql+psycopg2://auditor:auditor@localhost:5432/compliance

# Phase 2 backend: "setfit" (fine-tuned, CPU friendly) or "zero_shot" (bart-large-mnli)
CLASSIFIER_BACKEND=setfit
ZERO_SHOT_MODEL=facebook/bart-large-mnli
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SETFIT_MODEL_DIR=models/setfit
SPAN_MODEL_DIR=models/span_extractor

# Routing thresholds
FLAG_THRESHOLD=0.70
SEMANTIC_THRESHOLD=0.55
